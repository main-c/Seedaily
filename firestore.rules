rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profils utilisateurs ───────────────────────────────────────────────
    // Chaque utilisateur ne peut lire/écrire que son propre profil.

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Groupes ────────────────────────────────────────────────────────────

    match /groups/{groupId} {

      // Lecture réservée aux membres. Pas de `list` : on retrouve un groupe
      // par son code via inviteCodes/{code}, jamais par une requête.
      allow get: if request.auth != null && isMember(groupId);

      // Création : n'importe quel utilisateur connecté peut créer un groupe.
      // L'hostId doit correspondre à son UID.
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      // Mise à jour / suppression : réservées à l'hôte.
      allow update, delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // ── Membres ───────────────────────────────────────────────────────
      match /members/{memberId} {

        // Lecture : accessible à tout membre du groupe, et chacun peut lire
        // sa propre fiche (même inexistante) pour vérifier s'il est déjà membre.
        allow read: if request.auth != null
          && (memberId == request.auth.uid || isMember(groupId));

        // Fiche créée par l'utilisateur lui-même :
        // - l'hôte, dans le même batch que le groupe ;
        // - un membre, seulement avec le bon code d'invitation.
        allow create: if request.auth != null
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && ((request.resource.data.role == 'host'
                && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.hostId == request.auth.uid)
            || (request.resource.data.role == 'member'
                && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.groupId == groupId));

        // Quitter : un membre peut supprimer sa propre fiche.
        // Supprimer le groupe : l'hôte peut supprimer toutes les fiches.
        allow delete: if request.auth != null
          && (memberId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || isHost(groupId));
      }

      // ── Progression ───────────────────────────────────────────────────
      match /progress/{progressId} {

        // Lecture : accessible à tout membre du groupe.
        allow read: if request.auth != null && isMember(groupId);

        // Écriture : un membre ne gère que sa propre progression.
        // (set() sur un jour déjà présent devient un update.)
        allow create: if request.auth != null
          && isMember(groupId)
          && request.resource.data.userId == request.auth.uid;

        allow update: if request.auth != null
          && isMember(groupId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        // L'hôte peut aussi tout supprimer quand il supprime le groupe.
        allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isHost(groupId));
      }
    }

    // ── Codes d'invitation ─────────────────────────────────────────────────
    // inviteCodes/{code} → { groupId }. Lisible seulement si on connaît le code.
    // Pas d'update : un code déjà pris fait échouer la création du groupe.

    match /inviteCodes/{code} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['groupId'])
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.hostId == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;

      allow delete: if request.auth != null
        && isHost(resource.data.groupId);
    }

    // ── Requête collectionGroup sur 'members' ──────────────────────────────
    // Permet à watchUserGroups() de lister tous les groupes d'un utilisateur
    // via collectionGroup('members').where('userId', ==, uid).

    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ── Fonction helper ────────────────────────────────────────────────────

    function isMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isHost(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.hostId == request.auth.uid;
    }
  }
}
